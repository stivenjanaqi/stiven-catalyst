{%- if site.newsletter.action %}
<section class="shell newsletter" aria-labelledby="newsletter-title">
  <div>
    <p class="kicker">Newsletter</p>
    <h2 id="newsletter-title">New thinking, <span>when it is ready.</span></h2>
    <p>New essays and field notes by email. No schedule pressure, no noise. Unsubscribe at any time.</p>
  </div>
  <form class="newsletter-form" action="{{ site.newsletter.action }}" method="post" target="_blank">
    <label class="visually-hidden" for="newsletter-email">Email address</label>
    <div class="newsletter-row">
      <input id="newsletter-email" type="email" name="{{ site.newsletter.emailField }}" placeholder="you@example.com" autocomplete="email" required>
      <button type="submit">Subscribe</button>
    </div>
    {%- for name, value in site.newsletter.hiddenFields %}
    <input type="hidden" name="{{ name }}" value="{{ value }}">
    {%- endfor %}
    <p class="form-note">You will get an email to confirm your subscription.{% if legal.street %} Details in the <a href="/datenschutz.html">privacy policy</a>.{% endif %}</p>
  </form>
</section>
{%- endif %}
