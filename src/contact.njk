---
layout: layouts/base.njk
title: Contact
description: Get in touch with Stiven Catalyst.
permalink: /contact.html
---
<section class="shell page-hero">
  <p class="eyebrow">Get in touch</p>
  <h1>Contact</h1>
  <p class="lede">Questions, ideas or a conversation about leadership, operations and systems. Messages are read personally.</p>
</section>
<section class="shell contact">
  {%- if site.contact.action %}
  <form class="contact-form" action="{{ site.contact.action }}" method="post">
    <div class="field">
      <label for="contact-name">Name</label>
      <input id="contact-name" name="name" autocomplete="name" required>
    </div>
    <div class="field">
      <label for="contact-email">Email</label>
      <input id="contact-email" type="email" name="email" autocomplete="email" required>
    </div>
    <div class="field">
      <label for="contact-message">Message</label>
      <textarea id="contact-message" name="message" rows="7" required></textarea>
    </div>
    <input type="text" name="_gotcha" class="visually-hidden" tabindex="-1" autocomplete="off" aria-hidden="true">
    <button type="submit">Send message</button>
    <p class="form-note">Your details are only used to reply to you.{% if legal.name and legal.city %} Details in the <a href="/datenschutz.html">privacy policy</a>.{% endif %}</p>
  </form>
  {%- endif %}
  <aside class="contact-aside">
    <p class="kicker">Email</p>
    <a class="text-link" href="mailto:{{ site.email }}">{{ site.email }} <span aria-hidden="true">→</span></a>
  </aside>
</section>
