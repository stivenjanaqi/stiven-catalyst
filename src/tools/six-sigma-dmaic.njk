---
layout: layouts/base.njk
title: Six Sigma in the Warehouse
description: "A free, short DMAIC course built on one warehouse case: define, measure, analyze, improve and control outbound damage, with a quiz for each step, the eight wastes, a glossary and a project charter."
activeNav: /tools.html
permalink: /tools/six-sigma-dmaic/
---
<section class="shell page-hero tool-hero">
  <p class="eyebrow">Free course · Six Sigma</p>
  <h1>Six Sigma in the Warehouse</h1>
  <p class="lede">DMAIC in five steps and one real case. Each step says what to do, shows it on the warehouse floor, links the tool to use and ends with three questions. Start your own project with the charter at the bottom.</p>
</section>

<nav class="shell dm-nav" aria-label="Course steps" data-dm-nav>
  <ol class="dm-steps">
    {%- for m in dmaic.modules %}
    <li><a href="#dm-{{ m.id }}" data-step="{{ m.id }}"><span class="dm-step-letter">{{ m.letter }}</span><span class="dm-step-name">{{ m.name }}</span></a></li>
    {%- endfor %}
  </ol>
  <div class="dm-progress">
    <div class="bar-track"><div class="bar-fill" data-progress-bar></div></div>
    <p class="form-note" data-progress-text aria-live="polite">Answer the questions to track your progress.</p>
  </div>
  <p class="dm-more"><a class="inline-link" href="#dm-wastes">8 wastes</a><a class="inline-link" href="#dm-glossary">Glossary</a><a class="inline-link" href="#dm-charter">Project charter</a></p>
</nav>

<section class="shell dm-case">
  <p class="kicker">Throughout the course</p>
  <h2>{{ dmaic.case.title }}</h2>
  <p>{{ dmaic.case.text }}</p>
</section>

{%- for m in dmaic.modules %}
{%- set mi = loop.index0 %}
<section class="shell dm-module" id="dm-{{ m.id }}" data-module="{{ m.id }}">
  <header class="dm-module-head">
    <span class="dm-letter" aria-hidden="true">{{ m.letter }}</span>
    <div>
      <p class="kicker">Step {{ loop.index }} of 5 · Output: {{ m.output }}</p>
      <h2>{{ m.name }}</h2>
      <p class="dm-goal">{{ m.goal }}</p>
    </div>
  </header>

  <div class="dm-grid">
    <div class="dm-col">
      <h3 class="result-label">Key ideas</h3>
      <dl class="dm-ideas">
        {%- for idea in m.ideas %}
        <div><dt>{{ idea[0] }}</dt><dd>{{ idea[1] }}</dd></div>
        {%- endfor %}
      </dl>
      <h3 class="result-label">Common mistakes</h3>
      <ul class="tips dm-mistakes">
        {%- for item in m.mistakes %}
        <li>{{ item }}</li>
        {%- endfor %}
      </ul>
    </div>
    <article class="result-card dm-case-card">
      <p class="result-label">In the case</p>
      <dl class="dm-case-rows">
        {%- for row in m.case %}
        <div><dt>{{ row[0] }}</dt><dd>{{ row[1] }}</dd></div>
        {%- endfor %}
      </dl>
      <p class="result-label">Tools for this step</p>
      <ul class="dm-tools">
        {%- for tool in m.tools %}
        <li><a class="text-link" href="{{ tool[1] }}">{{ tool[0] }} <span aria-hidden="true">→</span></a> <span>{{ tool[2] }}</span></li>
        {%- endfor %}
      </ul>
    </article>
  </div>

  <div class="dm-grid dm-grid-check">
    <div class="dl-box">
      <p class="kicker">Before you move on</p>
      <ul class="dm-checklist">
        {%- for item in m.checklist %}
        <li><label class="dl-check-item"><input type="checkbox" data-check="{{ m.id }}-{{ loop.index0 }}"><span>{{ item }}</span></label></li>
        {%- endfor %}
      </ul>
    </div>
    <div class="dl-box dm-quiz" data-quiz="{{ m.id }}">
      <p class="kicker">Check yourself</p>
      {%- for q in m.quiz %}
      {%- set qi = loop.index0 %}
      <fieldset class="dm-question" data-question="{{ qi }}">
        <legend><span class="statement-number">{{ loop.index | pad }}</span>{{ q.q }}</legend>
        <div class="dm-options">
          {%- for option in q.options %}
          <label class="dm-option"><input type="radio" name="q-{{ m.id }}-{{ qi }}" value="{{ loop.index0 }}"><span>{{ option }}</span></label>
          {%- endfor %}
        </div>
        <p class="dm-feedback" data-feedback aria-live="polite" hidden></p>
      </fieldset>
      {%- endfor %}
      <p class="form-note dm-score" data-score></p>
    </div>
  </div>
</section>
{%- endfor %}

<section class="shell dm-extra" id="dm-wastes">
  <div class="section-heading">
    <div>
      <p class="kicker">Lean basics</p>
      <h2>The eight wastes in the warehouse</h2>
    </div>
    <p>DOWNTIME: eight kinds of work the customer does not pay for. Walk one shift and write down one example of each.</p>
  </div>
  <div class="dm-wastes">
    {%- for w in dmaic.wastes %}
    <article class="dm-waste">
      <span class="dm-waste-letter" aria-hidden="true">{{ w[0] }}</span>
      <h3>{{ w[1] }}</h3>
      <p>{{ w[2] }}</p>
    </article>
    {%- endfor %}
  </div>
</section>

<section class="shell dm-extra" id="dm-glossary">
  <div class="section-heading">
    <div>
      <p class="kicker">Words you will hear</p>
      <h2>Glossary</h2>
    </div>
    <p>The terms used in this course and in the tools, in plain words.</p>
  </div>
  <dl class="dm-glossary">
    {%- for term in dmaic.glossary %}
    <div><dt>{{ term[0] }}</dt><dd>{{ term[1] }}</dd></div>
    {%- endfor %}
  </dl>
</section>

<section class="shell dm-extra dm-charter" id="dm-charter">
  <div class="section-heading">
    <div>
      <p class="kicker">Your project</p>
      <h2>DMAIC project charter</h2>
    </div>
    <p>One page that the team and the sponsor agree on before measuring starts. Fill it in, print it and bring it to the first meeting.</p>
  </div>
  <form class="dl-box" data-charter>
    <div class="worksheet-grid dm-charter-grid">
      {%- for f in dmaic.charter %}
      <div class="field{% if f[3] %} wide{% endif %}">
        <label for="ch-{{ f[0] }}">{{ f[1] }}</label>
        {%- if f[3] %}
        <textarea id="ch-{{ f[0] }}" name="{{ f[0] }}" rows="2" placeholder="{{ f[2] }}"></textarea>
        {%- else %}
        <input id="ch-{{ f[0] }}" name="{{ f[0] }}" placeholder="{{ f[2] }}" autocomplete="off">
        {%- endif %}
      </div>
      {%- endfor %}
    </div>
    <div class="tool-actions">
      <button class="button-primary" type="button" data-charter-print>Print or save as PDF</button>
      <button class="button-secondary" type="button" data-charter-copy>Copy as text</button>
      <button class="button-secondary" type="button" data-charter-example>Fill with the course case</button>
      <button class="button-secondary" type="button" data-charter-clear>Clear</button>
    </div>
    <p class="form-note" data-charter-status aria-live="polite">Your charter is kept only in this browser.</p>
  </form>
</section>

<script type="application/json" id="dmaic-data">{{ dmaic | dump | safe }}</script>
<script src="/js/tool-kit.js" defer></script>
<script src="/js/dmaic.js" defer></script>
