---
activeNav: /
layout: layouts/base.njk
permalink: /index.html
---
{%- set featured = collections.insights | featured -%}
{%- set others = collections.insights | except(featured) | last(3) -%}
  <section class="shell hero">
    <div>
      <p class="eyebrow">Stiven Catalyst · Leadership · Operations · People</p>
      <h1>
        <span class="line">See clearly.</span>
        <span class="line">Think differently.</span>
        <span class="line act">Act deliberately.</span>
      </h1>
      <p class="hero-copy"><strong>Ideas that move work forward.</strong> A modern publication about the people, systems and decisions behind better performance, written close to the work, not from a distance.</p>
    </div>

    <div class="hero-side">
      <div class="brand-poster" role="img" aria-label="Stiven Catalyst visual identity inspired by the original Catalyst Coaching logo">
        <span class="brand-cable"></span>
        <span class="brand-bulb"></span>
        <div class="brand-wordmark">
          <small>STIVEN</small>
          <strong>CATALYST</strong>
          <em>Clarity · Insight · Action · Change</em>
        </div>
      </div>
      <p>The light is the moment of clarity. The catalyst is what happens next.</p>
    </div>
  </section>

  <div class="shell meta-strip" aria-label="Stiven Catalyst philosophy">
    <div><strong>Clarity</strong><span>Understand before reacting.</span></div>
    <div><strong>People</strong><span>Performance is lived by people.</span></div>
    <div><strong>Systems</strong><span>Make good work repeatable.</span></div>
    <div><strong>Change</strong><span>Turn insight into movement.</span></div>
  </div>

  <section class="shell section philosophy">
    <div class="manifesto">
      <div class="manifesto-line">
        <span>Observation</span>
        <span class="blue">into insight.</span>
        <span>Insight</span>
        <span class="red">into action.</span>
      </div>
      <div class="manifesto-copy">
        <p>Stiven Catalyst exists to turn clearer thinking into better action.</p>
        <p>Leadership is not distance from the work. Management is not control. A KPI is not the operation. And an idea is not change until something moves.</p>
        <p>This is a place for practical thinking on leadership, operations, people and systems, grounded in real work and built to be useful.</p>
        <a class="text-link" href="/about.html">Read the philosophy <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="shell section">
    <div class="section-heading">
      <div>
        <p class="kicker">Featured thinking</p>
        <h2>From the work itself.</h2>
      </div>
      <p>Practical ideas shaped by real operations: how teams perform, where processes break and what better management can change.</p>
    </div>

    <div class="feature-grid">
      {%- if featured %}
      <article class="feature-card" data-number="{{ featured.data.number }}">
        <div class="feature-meta"><span>{{ featured.data.category }}</span>{% if featured.data.read_time %}<span>{{ featured.data.read_time }} read</span>{% endif %}</div>
        <div>
          <h3>{{ featured.data.title }}</h3>
          <p>{{ featured.data.teaser or featured.data.summary }}</p>
        </div>
        <a class="text-link" href="{{ featured.url }}">Read the essay <span aria-hidden="true">→</span></a>
      </article>
      {%- endif %}

      <div class="side-stack">
        {%- for item in home.highlights %}
        <article class="mini-card">
          <div class="card-meta"><span>{{ item.label }}</span><span>{{ item.type }}</span></div>
          <h3>{% if item.link %}<a href="{{ item.link }}">{{ item.title }}</a>{% else %}{{ item.title }}{% endif %}</h3>
        </article>
        {%- endfor %}
      </div>
    </div>
  </section>

  <section class="shell section">
    <div class="section-heading">
      <div>
        <p class="kicker">Latest insights</p>
        <h2>Management without theatre.</h2>
      </div>
      <p>No slogans. No recycled corporate language. Just clearer thinking about people, standards, accountability and execution.</p>
    </div>

    <div class="article-grid">
      {%- for item in others %}
      <article class="article-card">
        <span class="card-number">{{ item.data.number }}</span>
        <div class="card-meta"><span>{{ item.data.category }}</span></div>
        <h3>{{ item.data.title }}</h3>
        <p>{{ item.data.teaser or item.data.summary }}</p>
        {%- if item.data.status == "soon" %}
        <span class="soon">Coming soon</span>
        {%- else %}
        <a class="text-link" href="{{ item.url }}">Read more <span aria-hidden="true">→</span></a>
        {%- endif %}
      </article>
      {%- endfor %}
    </div>
  </section>

  <section class="shell section">
    <div class="section-heading">
      <div>
        <p class="kicker">Field notes</p>
        <h2>Short observations. Real work.</h2>
      </div>
      <p>Smaller ideas captured close to the moment: from shifts, teams, service environments and everyday operations.</p>
    </div>

    <div class="notes-grid">
      {%- for note in collections.notes | first(2) %}
      <article class="note-card">
        <blockquote>“{{ note.data.quote }}”</blockquote>
        <time datetime="{{ note.date | isoDate }}">{{ note.date | readableDate }}</time>
      </article>
      {%- endfor %}
    </div>
  </section>

{% include "partials/newsletter.njk" %}

  <section class="shell cta">
    <h2>Build better systems. <span>Lead people better.</span></h2>
    <div class="cta-side">
      <p>Stiven Catalyst is an evolving archive of practical management thinking, projects and field experience.</p>
      <a class="text-link" href="/about.html">About Stiven Catalyst <span aria-hidden="true">→</span></a>
    </div>
  </section>
